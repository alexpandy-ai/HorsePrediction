# Copy this file to backend/.env and set a password there.
# backend/.env is gitignored. Do not commit a real password.

POSTGRES_DB=horsepredictor
POSTGRES_USER=horsepredictor
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/horsepredictor
SPRING_DATASOURCE_USERNAME=horsepredictor
SPRING_DATASOURCE_PASSWORD=
SERVER_PORT=8080
